# Production .env template for ReForge.
#
# Copy to `.env` on the deployment host (NEVER commit the populated file).
# Every value marked REQUIRED must be set before `docker-compose.prod.yml`
# can boot a healthy stack. Optional fields can be omitted; sensible
# defaults are documented inline.
#
# After provisioning the .env, the deploy workflow runs:
#   docker compose -f docker-compose.prod.yml run --rm api alembic upgrade head
# and then starts the long-lived services.

# ────────────────────────────────────────────────────────────────────
# Runtime mode (P-5 fix)
# ────────────────────────────────────────────────────────────────────
# `Settings.ENV == "local"` short-circuits Celery into eager mode and
# enables the in-process schema bootstrap (`Base.metadata.create_all`).
# Both behaviors are dangerous in production. ALWAYS set ENV=production
# (or any non-"local" value) on production hosts.
ENV=production

# Celery eager mode MUST be off in production. Without an explicit "false"
# the in-code default is True, which would silently make every Celery call
# block the API request thread instead of dispatching to the worker.
CELERY_TASK_ALWAYS_EAGER=false
CELERY_ALWAYS_EAGER=false

# Demo / evaluation only: keep OFF in real production. When true, the API
# blocks destructive deletes and platform disconnects and may return dry-run
# publish payloads instead of dispatching. Never set NEXT_PUBLIC_EVALUATION_MODE
# on a public customer-facing deployment unless you intend that behavior.
# EVALUATION_MODE=false

# ────────────────────────────────────────────────────────────────────
# Postgres (REQUIRED)
# ────────────────────────────────────────────────────────────────────
# Used both by the `postgres` service to bootstrap and by the API/worker
# to compose the DATABASE_URL. POSTGRES_PASSWORD has no default and the
# compose file refuses to start without it.
POSTGRES_USER=reforge
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=reforge

# Optional: explicitly override DATABASE_URL if you point at a managed
# Postgres outside the compose stack (e.g. RDS, Supabase, Neon).
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/reforge

# ────────────────────────────────────────────────────────────────────
# Redis (broker + result backend)
# ────────────────────────────────────────────────────────────────────
# Defaults to the in-stack `redis` service. Override only if you point
# at a managed Redis (Upstash, Elasticache).
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1

# ────────────────────────────────────────────────────────────────────
# Security (REQUIRED — see B-1 fix)
# ────────────────────────────────────────────────────────────────────
# Long random value used as the JWT signing secret AND the OAuth state
# HMAC secret. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string

# Encryption key for OAuth tokens at rest (Fernet). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If omitted, ReForge derives a stable Fernet key from SECRET_KEY — but a
# dedicated value is strongly recommended so SECRET_KEY can be rotated
# without invalidating every stored OAuth token.
FERNET_KEY=change-me-via-Fernet.generate_key

# ────────────────────────────────────────────────────────────────────
# Networking / CORS
# ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
DEBUG=false
API_PORT=8000
UVICORN_WORKERS=2

# ────────────────────────────────────────────────────────────────────
# Celery worker concurrency (P-8 fix)
# ────────────────────────────────────────────────────────────────────
# Tune to roughly the number of CPU cores available to the worker
# container. The compose default is 4; raise or lower as appropriate.
CELERY_CONCURRENCY=4

# ────────────────────────────────────────────────────────────────────
# AI providers (REQUIRED — see B-9 fix)
# ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Optional alias retained for backward compatibility:
# GOOGLE_API_KEY=

# Optional fallback when Gemini is unavailable / quota exhausted:
# OPENROUTER_API_KEY=

# ────────────────────────────────────────────────────────────────────
# Cloudinary (recommended in production)
# ────────────────────────────────────────────────────────────────────
# When unset, content uploads fall back to a local `uploads/` directory
# inside the container. The compose stack already mounts a named volume
# for that fallback (P-6), but Cloudinary is strongly recommended in
# production for CDN, transformations, and durability.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ────────────────────────────────────────────────────────────────────
# Social platform OAuth credentials
# ────────────────────────────────────────────────────────────────────
# Replace localhost callback URLs with your production hostnames.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/connections/youtube/callback

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=https://api.example.com/api/v1/connections/twitter/callback

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://api.example.com/api/v1/connections/meta/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://api.example.com/api/v1/connections/linkedin/callback

OAUTH_FRONTEND_RETURN_URL=https://app.example.com/connections
