# Copy this file to `.env` at the repository root OR `backend/.env`.

# ── Gemini AI (optional; omit uses safe fallback captions in some paths) ─────
GEMINI_API_KEY=
# Optional alias: GOOGLE_API_KEY=

# ── OpenRouter (optional fallback when Gemini is unavailable/quota exhausted) ─
OPENROUTER_API_KEY=

# ── Redis (optional for local dev) ────────────────────────────────────────────
# `app.core.config` defaults to in-memory Celery broker + eager tasks when ENV=local.
# Uncomment when you run a real Celery worker with Redis:
# REDIS_URL=redis://localhost:6379/0
# REDIS_BACKEND_URL=redis://localhost:6379/1

# ── Database ─────────────────────────────────────────────────────────────────
# Omit to use SQLite in the backend directory: sqlite+aiosqlite:///./reforge.db
# DATABASE_URL=sqlite+aiosqlite:///./reforge.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/reforge

# ── Cloudinary (optional; upload falls back to local `uploads/` if unset) ────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Demo / evaluation (optional) ─────────────────────────────────────────────
# When true: block content delete + platform disconnect; publish with no
# dispatch targets returns a dry-run JSON payload (no Celery / no external APIs).
# Mirror on the frontend with NEXT_PUBLIC_EVALUATION_MODE=true in frontend/.env.local
# EVALUATION_MODE=false

# ── FastAPI ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-use-a-long-random-string-for-production
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000

# OAuth tokens at rest (Fernet). Optional: omit or leave default and ReForge derives a stable key from SECRET_KEY.
# For production set explicitly: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FERNET_KEY=

# ── Celery (production / non-local) ───────────────────────────────────────────
# ENV=local forces eager Celery regardless. For workers, use Redis URLs above.
CELERY_TASK_ALWAYS_EAGER=false

# ── Social platform OAuth credentials ─────────────────────────────────────────
# YouTube (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/connections/youtube/callback

# Twitter / X (OAuth2, PKCE) — register app in https://developer.x.com/
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:8000/api/v1/connections/twitter/callback

# Meta (powers both Facebook + Instagram) — register at https://developers.facebook.com/
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/connections/meta/callback

# LinkedIn — register at https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must match an "Authorized redirect URL" on the app Auth tab EXACTLY (http vs https,
# localhost vs 127.0.0.1, port, path, no trailing slash unless you registered one).
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/connections/linkedin/callback
# Optional. If LinkedIn shows "Bummer, something went wrong", your app may lack a Product
# for posting (w_member_social). Try Sign-In only while testing OpenID:
# LINKEDIN_OAUTH_SCOPES=openid profile email
# Then enable Products: "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn"
# (or Marketing Developer Platform), remove the line above, reconnect for full posting scopes.

# Where to send the browser after OAuth completes
OAUTH_FRONTEND_RETURN_URL=http://localhost:3000/connections
